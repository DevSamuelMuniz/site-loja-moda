# Variaveis de ambiente da loja.
#
# Copie para `.env.local` e preencha.
#
# Obrigatorias desde a FASE 1: `DATABASE_URL`/`DIRECT_URL` (o catalogo vem do banco, e o
# build le o banco) e `AUTH_SECRET` (login do painel). Sem elas o build e o login falham.
# As demais tem valor demonstrativo e existem para publicar de verdade.
#
# Reinicie o servidor depois de alterar (`npm run dev`).

# ---------------------------------------------------------------------------
# Banco de dados — obrigatorio a partir da FASE 1 (Neon, via Vercel Marketplace)
# ---------------------------------------------------------------------------

# Conexao COM POOL, usada pela aplicacao. No Neon e a string que termina em `-pooler`.
# Configure tambem nas Environment Variables da Vercel (producao e preview).
DATABASE_URL=

# Conexao DIRETA. `prisma migrate` nao funciona atraves do pool: e essa que ele usa.
DIRECT_URL=

# ---------------------------------------------------------------------------
# Autenticacao (Auth.js v5)
# ---------------------------------------------------------------------------

# Assinatura das sessoes. Gere com `npx auth secret` e nunca versione o valor.
# Obrigatoria tambem nas Environment Variables da Vercel: sem ela o login falha.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Acesso criado pelo seed (opcional)
# ---------------------------------------------------------------------------

# O seed nao cria nenhuma conta por conta propria: sem SEED_ADMIN_PASSWORD ele termina
# com `usuarios: 0`. E proposital — assim um deploy em producao nunca nasce com uma
# senha conhecida, e a conta de acesso passa a ser ato explicito do operador.
# Localmente, preencha a senha para ter como entrar no painel.
SEED_ADMIN_PASSWORD=194bwer516816t41er14r1w47
SEED_ADMIN_EMAIL=admin@aura.test

# Contas de demonstracao (`cliente@aura.test` ativa e um operador inativo), com senha
# fixa no seed. So existem em ambiente de demonstracao: em producao, deixe vazio.
SEED_DEMO_USERS=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# URL absoluta do site. Usada por canonical, Open Graph, sitemap e robots.
# Em producao, sem barra no final. Sem ela, o padrao e http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bloqueia toda a indexacao quando for "false". Util em homologacao.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Codigo de verificacao do Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Identidade visual
# ---------------------------------------------------------------------------

# Tema ativo: minimal | luxury | streetwear | feminine | bold | sport | corporate | custom
NEXT_PUBLIC_THEME=minimal

# ---------------------------------------------------------------------------
# Atendimento
# ---------------------------------------------------------------------------

# Numero no formato internacional, apenas digitos (55 + DDD + numero).
NEXT_PUBLIC_WHATSAPP_NUMBER=5581984639299
# ---------------------------------------------------------------------------
# Analytics (nenhum evento e enviado enquanto estiverem vazios)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Formularios (sem endpoint, a interface avisa que o envio nao esta conectado)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
NEXT_PUBLIC_CONTACT_ENDPOINT=
